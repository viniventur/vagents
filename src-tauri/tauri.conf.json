{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vAgents",
  "version": "0.2.0",
  "identifier": "br.com.viniciusventura.vagents",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "create": false,
        "title": "vAgents",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Vinícius Ventura",
    "shortDescription": "As sessões do Claude Code e os subagentes de cada uma, ao vivo",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
